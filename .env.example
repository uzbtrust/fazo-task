# Local SQLite. Production must use a dedicated remote Turso database.
TURSO_DATABASE_URL=file:./fazo.db
TURSO_AUTH_TOKEN=
# Optional initial admin password. Defaults to admin only on first setup.
ADMIN_INITIAL_PASSWORD=admin
# Telegram bot (@BotFather). Bo‘sh qolsa, bot va Telegram orqali kirish o‘chiq turadi.
BOT_TOKEN=
# Sayt manzili bot havolalari uchun. Vercel'da shart emas: production manzili o‘zi olinadi.
APP_URL=
